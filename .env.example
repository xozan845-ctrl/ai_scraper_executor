# General
NODE_ENV=development
LOG_LEVEL=info

# API
PORT=3000
# Auth (ETAPA 4): claves coma-separadas. Vacío = sin auth (dev/tests).
API_KEYS=
# Primera ejecución (bootstrap): token requerido por `/auth/register-first` en producción (header X-First-Run).
FIRST_RUN_TOKEN=
# Proxy inverso/LB: nº de saltos de confianza para que req.ip (rate-limit) sea real. Vacío = desactivado.
TRUST_PROXY=
# CORS: orígenes permitidos (coma-separados). Vacío = abierto en dev, mismo-origen en producción.
CORS_ORIGINS=
# Allowlist de dominios por job (ETAPA 4). Vacío = cualquier host público (SSRF sigue activo).
ALLOWED_DOMAINS=
# Rate-limit de creación de jobs por IP y minuto (ETAPA 4).
RATE_LIMIT_CREATE_PER_MIN=30
# Cifrado de credenciales de sesión (AES-256-GCM). Hex de 64 chars o frase (se deriva con scrypt).
# Requerido para guardar credenciales (Authorization/Cookie). Nunca se loguean.
CREDENTIALS_KEY=

# Postgres
DATABASE_URL=postgresql://scraper:scraper@localhost:5432/scraper?schema=public
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper
POSTGRES_DB=scraper

# Redis
REDIS_URL=redis://localhost:6379

# MongoDB (Memoria/Radiografía)
MONGODB_URI=mongodb://localhost:27017/scraper
MONGODB_DB=scraper

# AI — proveedor predeterminado: openrouter (§15)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-sustituir
# openrouter/free = router que auto-selecciona un modelo gratuito disponible (recomendado para tests).
# Alternativa: usar un modelo concreto con sufijo ":free", p.ej. qwen/qwen3.8-27b:free
OPENROUTER_MODEL=openrouter/free
# Modelos fallback (coma-separados) si el principal falla con 404 (no existe) o 429 (rate limit).
# IDs verificados 2026 (los :free cambian con frecuencia; consulta https://openrouter.ai/models?q=free)
OPENROUTER_FALLBACK_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI — endpoint personalizado (§16)
AI_CUSTOM_ENDPOINT=
AI_CUSTOM_API_KEY=
AI_CUSTOM_MODEL=

AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=60000

# Crawlee
CRAWLEE_HEADLESS=true
CRAWLEE_MAX_CONCURRENCY=5
# Rate limiting §36 (peticiones/minuto por worker; vacío = sin límite)
CRAWLEE_MAX_REQUESTS_PER_MINUTE=

# Worker — concurrencia BullMQ por réplica (FASE 10, escalar con --scale worker=N)
WORKER_CONCURRENCY=2

# Caché de páginas FASE 11 (ETAPA 6): TTL y tope por réplica.
PAGE_CACHE_TTL_MS=300000
PAGE_CACHE_MAX_ENTRIES=100
