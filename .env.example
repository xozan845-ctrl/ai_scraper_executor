# General
NODE_ENV=development
LOG_LEVEL=info

# API
PORT=3000

# Postgres
DATABASE_URL=postgresql://scraper:scraper@localhost:5432/scraper?schema=public
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper
POSTGRES_DB=scraper

# Redis
REDIS_URL=redis://localhost:6379

# AI — proveedor predeterminado: openrouter (§15)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-sustituir
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI — endpoint personalizado (§16)
AI_CUSTOM_ENDPOINT=
AI_CUSTOM_API_KEY=
AI_CUSTOM_MODEL=

AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=60000

# Crawlee
CRAWLEE_HEADLESS=true
CRAWLEE_MAX_CONCURRENCY=5
# Rate limiting §36 (peticiones/minuto por worker; vacío = sin límite)
CRAWLEE_MAX_REQUESTS_PER_MINUTE=

# Worker — concurrencia BullMQ por réplica (FASE 10, escalar con --scale worker=N)
WORKER_CONCURRENCY=2
