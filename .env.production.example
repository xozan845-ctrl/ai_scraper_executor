# Plantilla de PRODUCCIÓN — AI Web Scraping Executor
#
# No contiene secretos reales: los valores son marcadores `<...>` que el operador
# sustituye en el entorno del host. NO se commitea ningún `.env` con valores reales
# (R-DO-3, R-SE-17, R-DS-1). Este archivo documenta la configuración exigible en
# producción; los valores por defecto de desarrollo viven en `.env.example`.

# General
NODE_ENV=production
LOG_LEVEL=info

# API
PORT=3000
# Auth: OBLIGATORIO en producción. Sin API_KEYS, la API arranca cerrada (401 en todas
# las rutas protegidas) y emite un error explícito (R-SE-9). Claves coma-separadas.
API_KEYS=<genera-una-clave-larga-y-aleatoria>
# Bootstrap del primer usuario (POST /api/v1/auth/register-first, header X-First-Run).
# Vaciar tras registrar el primer usuario.
FIRST_RUN_TOKEN=<token-de-un-solo-uso>
# Proxy inverso/LB: nº de saltos de confianza para que req.ip (rate-limit) sea real.
TRUST_PROXY=<nº-de-proxies-o-vacío>
# CORS: orígenes reales del dashboard, coma-separados. Vacío = mismo-origen (sin CORS).
CORS_ORIGINS=<https://tu-dominio.example>
# Allowlist de dominios permitidos por job. Vacío = cualquier host público (R-SE-5).
ALLOWED_DOMAINS=
# Rate-limit de creación de jobs por IP y minuto.
RATE_LIMIT_CREATE_PER_MIN=30
# Cifrado de credenciales de sesión (AES-256-GCM). Hex de 64 chars o frase.
# OBLIGATORIA si se van a guardar credenciales; DISTINTA por entorno (R-SE-12).
CREDENTIALS_KEY=<clave-simetrica-de-64-hex-o-frase-larga>

# Postgres (no reutilizar credenciales de desarrollo)
DATABASE_URL=postgresql://<usuario>:<password>@<host>:5432/<db>?schema=public
POSTGRES_USER=<usuario>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<db>

# Redis
REDIS_URL=redis://<host>:6379

# MongoDB (Memoria/Radiografía)
MONGODB_URI=mongodb://<host>:27017/<db>
MONGODB_DB=<db>

# AI — proveedor y modelos
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=<sk-...>
# Un modelo concreto y estable para producción; `openrouter/free` es para desarrollo/tests.
OPENROUTER_MODEL=<proveedor/modelo>
OPENROUTER_FALLBACK_MODELS=<proveedor/modelo:free,...>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI — endpoint personalizado (alternativa a OpenRouter / Ollama)
AI_CUSTOM_ENDPOINT=
AI_CUSTOM_API_KEY=
AI_CUSTOM_MODEL=

AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=60000

# Crawlee
CRAWLEE_HEADLESS=true
CRAWLEE_MAX_CONCURRENCY=5
# Vacío = sin límite de peticiones/min por worker (mejor ponerlo en producción).
CRAWLEE_MAX_REQUESTS_PER_MINUTE=<peticiones-por-minuto>

# Worker
WORKER_CONCURRENCY=2

# Caché de páginas
PAGE_CACHE_TTL_MS=300000
PAGE_CACHE_MAX_ENTRIES=100
