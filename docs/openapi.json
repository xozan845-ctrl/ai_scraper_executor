  "paths": {
    "/api/v1/auth/api-keys": {
      "get": {
        "operationId": "ApiKeysController_list",
        "parameters": [
          {
            "description": "API key de administración (superadmin)",
            "in": "header",
            "name": "x-api-key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Lista API keys emitidas (sin el secreto)",
        "tags": [
          "auth"
        ]
      },
      "post": {
        "operationId": "ApiKeysController_create",
        "parameters": [
          {
            "description": "API key de administración (superadmin)",
            "in": "header",
            "name": "x-api-key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Clave creada; el campo apiKey solo aparece aquí"
          }
        },
        "summary": "Genera una API key de cliente (se muestra una sola vez)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/api-keys/{id}": {
      "delete": {
        "operationId": "ApiKeysController_revoke",
        "parameters": [
          {
            "description": "API key de administración (superadmin)",
            "in": "header",
            "name": "x-api-key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Revoca una API key de cliente",
        "tags": [
          "auth"
        ]
      }
    },
