{
  "components": {
    "schemas": {
      "CreateApiKeyDto": {
        "properties": {
          "name": {
            "example": "Cliente Acme — producción",
            "maxLength": 80,
            "minLength": 2,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreateJobDto": {
        "properties": {
          "ai": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JobAiDto"
              }
            ],
            "description": "Proveedor/modelo IA"
          },
          "instruction": {
            "example": "Obtén todos los productos con nombre, precio e imagen",
            "minLength": 3,
            "type": "string"
          },
          "limits": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JobLimitsDto"
              }
            ],
            "description": "Límites del job (§35)"
          },
          "priority": {
            "description": "FASE 11: 1 = máxima, 10 = mínima, 5 = defecto",
            "maximum": 10,
            "minimum": 1,
            "type": "number"
          },
          "render": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RenderOptionsDto"
              }
            ],
            "description": "Render con navegador para SPAs"
          },
          "url": {
            "description": "URL inicial (http/https)",
            "example": "https://www.sevasaonline.com/",
            "type": "string"
          },
          "webhookUrl": {
            "description": "URL que recibirá un POST firmado cuando el job termine",
            "example": "https://example.com/hooks/scraping",
            "type": "string"
          }
        },
        "required": [
          "url",
          "instruction"
        ],
        "type": "object"
      },
      "CreateScheduleDto": {
        "properties": {
          "ai": {
            "$ref": "#/components/schemas/JobAiDto"
          },
          "instruction": {
            "example": "Obtén todos los productos",
            "minLength": 3,
            "type": "string"
          },
          "intervalSec": {
            "description": "Intervalo entre ejecuciones (segundos)",
            "example": 3600,
            "minimum": 10,
            "type": "number"
          },
          "limits": {
            "$ref": "#/components/schemas/JobLimitsDto"
          },
          "maxRuns": {
            "description": "Número máximo de ejecuciones; al alcanzarlo queda COMPLETED",
            "minimum": 1,
            "type": "number"
          },
          "render": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RenderOptionsDto"
              }
            ],
            "description": "Render con navegador para SPAs"
          },
          "url": {
            "example": "https://www.sevasaonline.com/",
            "type": "string"
          },
          "webhookUrl": {
            "example": "https://example.com/hooks/scraping",
            "type": "string"
          }
        },
        "required": [
          "url",
          "instruction",
          "intervalSec"
        ],
        "type": "object"
      },
      "CreateSessionDto": {
        "properties": {
          "credentials": {
            "$ref": "#/components/schemas/CredentialsDto"
          },
          "url": {
            "example": "https://www.sevasaonline.com/",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "CredentialsDto": {
        "properties": {
          "headers": {
            "description": "Headers a enviar (Authorization/Cookie/...)",
            "example": {
              "Authorization": "Bearer x"
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "JobAiDto": {
        "properties": {
          "model": {
            "example": "openrouter/free",
            "type": "string"
          },
          "provider": {
            "enum": [
              "openrouter",
              "custom"
            ],
            "example": "openrouter",
            "type": "string"
          }
        },
        "type": "object"
      },
      "JobLimitsDto": {
        "properties": {
          "maxAiTokens": {
            "description": "Presupuesto de tokens IA (0/vacío = presupuesto por defecto del servidor)",
            "example": 200000,
            "maximum": 5000000,
            "minimum": 1,
            "type": "number"
          },
          "maxDepth": {
            "example": 2,
            "maximum": 10,
            "minimum": 1,
            "type": "number"
          },
          "maxItems": {
            "example": 50,
            "maximum": 100000,
            "minimum": 1,
            "type": "number"
          },
          "maxPages": {
            "example": 5,
            "maximum": 1000,
            "minimum": 1,
            "type": "number"
          },
          "maxRequests": {
            "example": 100,
            "maximum": 100000,
            "minimum": 1,
            "type": "number"
          },
          "maxRuntimeSec": {
            "example": 300,
            "maximum": 3600,
            "minimum": 1,
            "type": "number"
          }
        },
        "type": "object"
      },
      "RegisterFirstDto": {
        "properties": {
          "email": {
            "example": "admin@miempresa.com",
            "type": "string"
          },
          "password": {
            "example": "una-clave-larga-y-segura",
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "RenderOptionsDto": {
        "properties": {
          "mode": {
            "description": "auto = heurística del motor",
            "enum": [
              "auto",
              "always",
              "never"
            ],
            "type": "string"
          },
          "timeoutMs": {
            "description": "Timeout de render (ms)",
            "maximum": 60000,
            "minimum": 1000,
            "type": "number"
          },
          "waitForSelector": {
            "description": "Selector que debe existir antes de capturar",
            "example": "app-root",
            "type": "string"
          },
          "waitMs": {
            "description": "Espera mínima extra (ms)",
            "maximum": 10000,
            "minimum": 0,
            "type": "number"
          },
          "waitUntil": {
            "enum": [
              "domcontentloaded",
              "load",
              "networkidle"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "SendMessageDto": {
        "properties": {
          "instruction": {
            "example": "Obtén todos los productos con nombre, precio e imagen",
            "minLength": 2,
            "type": "string"
          }
        },
        "required": [
          "instruction"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "api-key": {
        "in": "header",
        "name": "x-api-key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "LA IA ES EL CEREBRO. CRAWLEE ES EL MOTOR.",
    "title": "AI Scraping Executor API",
    "version": "0.1.0"
  },
