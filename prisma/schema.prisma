// Prisma schema — modelo de datos §40.
// datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  role         String    @default("user")
  apiKeyHash   String?   @unique
  bootstrap    Boolean?  @unique
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  jobs         Job[]
}

model Job {
  id          String    @id @default(cuid())
  url         String
  instruction String
  status      String    @default("CREATED")
  limits      Json?
  aiProvider  String    @default("openrouter")
  aiModel     String?
  ownerScope  String    @default("anon")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  sessionId   String?
  session     Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  plans       ScrapingPlan[]
  commands    Command[]
  pages       Page[]
  results     Result[]
  errors      JobError[]
  aiRequests  AIInteraction[]

  // Índices (R-DB-4/R-DB-5): filtro+orden del listado, FK a User y a Session.
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([ownerScope, createdAt])
}

// Sesión tipo "chat": una URL a analizar con su contexto (radiografía) e historial.
model Session {
  id          String   @id @default(cuid())
  url         String
  domain      String
  status      String   @default("RADIOGRAPHY") // RADIOGRAPHY | READY | FAILED
  credentials String?  // JSON cifrado (AES-256-GCM)
  error       String?
  ownerScope  String   @default("anon")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    SessionMessage[]
  jobs        Job[]

  // Índices (R-DB-4/R-DB-5): sesiones de un dominio por recencia.
  @@index([domain, updatedAt])
  @@index([ownerScope, updatedAt])
}

model SessionMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  jobId     String?
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model ScrapingPlan {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  version   String   @default("1.0")
  payload   Json
  createdAt DateTime @default(now())

  @@index([jobId])
}

model Command {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([jobId])
}

model Page {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  depth     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([jobId])
}

model Result {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  data       Json
  sourceUrl  String?
  selector   String?
  confidence Float?
  createdAt  DateTime @default(now())

  @@index([jobId])
}

model JobError {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  message   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([jobId])
}

model AIInteraction {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider  String
  model     String?
  kind      String // plan | analyze | recover | interpret
  request   Json?
  response  Json?
  tokens    Int?
  latencyMs Int?
  createdAt DateTime @default(now())

  @@index([jobId])
}
