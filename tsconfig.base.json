{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@ai-scraper/core": ["packages/core/dist"],
      "@ai-scraper/commands": ["packages/commands/dist"],
      "@ai-scraper/crawler": ["packages/crawler/dist"],
      "@ai-scraper/execution-engine": ["packages/execution-engine/dist"],
      "@ai-scraper/ai": ["packages/ai/dist"],
      "@ai-scraper/ai-providers": ["packages/ai-providers/dist"],
      "@ai-scraper/storage": ["packages/storage/dist"],
      "@ai-scraper/queue": ["packages/queue/dist"],
      "@ai-scraper/security": ["packages/security/dist"],
      "@ai-scraper/shared-observability": ["libs/shared/observability/dist"],
      "@ai-scraper/mongodb": ["packages/mongodb/dist"],
      "@ai-scraper/redis": ["packages/redis/dist"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
