{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@ai-scraper/shared-core": ["libs/shared/core/dist"],
      "@ai-scraper/domain-execution": ["libs/domain/execution/dist"],
      "@ai-scraper/domain-scraper": ["libs/domain/scraper/dist"],
      "@ai-scraper/domain-ai": ["libs/domain/ai/dist"],
      "@ai-scraper/infrastructure-crawler": ["libs/infrastructure/crawler/dist"],
      "@ai-scraper/infrastructure-execution": ["libs/infrastructure/execution/dist"],
      "@ai-scraper/application-ai": ["libs/application/ai/dist"],
      "@ai-scraper/application-execution": ["libs/application/execution/dist"],
      "@ai-scraper/infrastructure-ai-providers": ["libs/infrastructure/ai-providers/dist"],
      "@ai-scraper/infrastructure-storage": ["libs/infrastructure/storage/dist"],
      "@ai-scraper/infrastructure-queue": ["libs/infrastructure/queue/dist"],
      "@ai-scraper/shared-security": ["libs/shared/security/dist"],
      "@ai-scraper/shared-observability": ["libs/shared/observability/dist"],
      "@ai-scraper/infrastructure-mongodb": ["libs/infrastructure/mongodb/dist"],
      "@ai-scraper/infrastructure-redis": ["libs/infrastructure/redis/dist"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
